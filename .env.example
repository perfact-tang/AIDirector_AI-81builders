AIAND_API_KEY=your-api-key
# Optional overrides:
# Installed with npm run skills:install; no global Skill installation is required.
# DIRECTOR_SKILL_PATH=/absolute/path/to/custom/direct-h3-storyboards
# Optional Python environment containing edge-tts:
# EDGE_TTS_PYTHON=/absolute/path/to/python

# Optional ffprobe binary for video duration checks:
# FFPROBE_BIN=/opt/homebrew/bin/ffprobe

# Optional FFmpeg binary used for voice duration checks, speed fitting and final MP4 audio:
# FFMPEG_BIN=/opt/homebrew/bin/ffmpeg

# Cloud Run (automatically required on Cloud Run; leave unset for local-only mode):
# CLOUD_MODE=true
# GOOGLE_CLOUD_PROJECT=vibecodingjapan
# FIREBASE_STORAGE_BUCKET=vibecodingjapan.firebasestorage.app
# FIREBASE_WEB_CONFIG={"apiKey":"public-web-api-key","authDomain":"vibecodingjapan.firebaseapp.com","projectId":"vibecodingjapan","appId":"web-app-id"}
# FIREBASE_GOOGLE_LOGIN=false
# TASKS_REGION=asia-northeast1
# TASKS_QUEUE=ai-director
# TASK_SERVICE_ACCOUNT=ai-director-run@vibecodingjapan.iam.gserviceaccount.com
# SERVICE_URL=https://ai-director-153532166169.asia-northeast1.run.app
