AIAND_API_KEY=your-api-key
# Optional overrides:
# AIAND_BIN=/absolute/path/to/aiand
# DIRECTOR_SKILL_PATH=/absolute/path/to/direct-h3-storyboards
# Optional Python environment containing edge-tts:
# EDGE_TTS_PYTHON=/absolute/path/to/python

# Optional FFmpeg ffprobe binary for narration duration checks:
# FFPROBE_BIN=/opt/homebrew/bin/ffprobe

# Optional FFmpeg binary used to lock the original narration into final MP4:
# FFMPEG_BIN=/opt/homebrew/bin/ffmpeg
